BOT_TOKEN=replace_with_new_bot_token
# Optional: permit only these Telegram user IDs (comma separated).
ALLOWED_USER_IDS=
# Public HTTPS address forwarded to this bot's HTTP server.
MINIAPP_URL=
# WEB_ENABLED=1 starts the API even before MINIAPP_URL is configured.
WEB_ENABLED=0
WEB_HOST=127.0.0.1
WEB_PORT=8080
